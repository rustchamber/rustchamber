#!/bin/sh
# Run the host's OpenCode CLI through the Flatpak spawn portal.
. /app/bin/host-env.sh

exec flatpak-spawn --watch-bus --host \
  --directory="$PWD" \
  --env="HOME=$HOST_HOME" \
  --env="PATH=$HOST_PATH" \
  --env="OPENCODE_PASSWORD=${OPENCODE_PASSWORD:-}" \
  --env="OPENCODE_SERVER_PASSWORD=${OPENCODE_SERVER_PASSWORD:-}" \
  --env="OPENCODE_SERVER_USERNAME=${OPENCODE_SERVER_USERNAME:-opencode}" \
  sh -c '
    pick_opencode() {
      fallback=""
      for candidate in \
        "$HOME/.opencode/bin/opencode" \
        "$HOME/.local/bin/opencode" \
        "$HOME/.local/share/openchamber/resources/opencode-cli/opencode" \
        "/opt/OpenChamber/resources/opencode-cli/opencode"; do
        [ -x "$candidate" ] || continue
        [ -n "$fallback" ] || fallback="$candidate"
        major=$("$candidate" --version 2>/dev/null | grep -o "[0-9]\+" | head -1)
        if [ -n "$major" ] && [ "$major" -ge 2 ]; then
          echo "$candidate"
          return 0
        fi
      done
      if [ -n "$fallback" ]; then
        echo "$fallback"
        return 0
      fi
      if command -v opencode >/dev/null 2>&1; then
        command -v opencode
        return 0
      fi
      return 1
    }
    candidate=$(pick_opencode) || {
      echo "RustChamber: OpenCode 2 was not found on the host." >&2
      echo "Install OpenCode 2 or set RCHAMBER_OPENCODE_BIN." >&2
      exit 127
    }
    exec "$candidate" "$@"
  ' sh "$@"
